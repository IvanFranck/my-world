{
  "name": "my-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:api-gateway": "turbo dev --filter @my-website/api-gateway",
    "dev:auth-service": "turbo dev --filter @my-website/auth-service",
    "dev:content-service": "turbo dev --filter @my-website/content-service",
    "dev:web": "turbo dev --filter @my-website/web",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules .turbo",
    "test:critical": "pnpm --filter @my-website/auth-service test:e2e",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "pnpm --filter @my-website/api-gateway exec eslint --fix",
      "pnpm --filter @my-website/auth-service exec eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "turbo": "^2.7.1",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.17.0",
    "pnpm": ">=10.17.0"
  }
}
